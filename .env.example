# Deployment policy (never put provider API keys or wallet private keys here)
FLIGHTPROOF_SOURCE_POLICY_VERSION=1
FLIGHTPROOF_MINIMUM_SOURCES=2
FLIGHTPROOF_MAXIMUM_SOURCE_SPREAD_MINUTES=15
FLIGHTPROOF_CONSENSUS_DRIFT_MINUTES=2
FLIGHTPROOF_FINALIZATION_GRACE_MINUTES=60
FLIGHTPROOF_SOURCE_PREFIX_1=https://adapter-one.example/v1/flights/
FLIGHTPROOF_SOURCE_PREFIX_2=https://adapter-two.example/v1/flights/
FLIGHTPROOF_SOURCE_PREFIX_3=

# Receipt polling only; defaults allow up to two hours for consensus, appeals, and finality.
FLIGHTPROOF_RECEIPT_RETRIES=1440
FLIGHTPROOF_RECEIPT_INTERVAL_MS=5000
